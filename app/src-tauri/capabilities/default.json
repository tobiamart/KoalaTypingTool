{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "opener:default",
    "dialog:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME" }, { "path": "$HOME/**" }],
      "deny": [
        { "path": "$HOME/.ssh" },
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.aws" },
        { "path": "$HOME/.aws/**" },
        { "path": "$HOME/.gnupg" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.config/**" },
        { "path": "$HOME/Library/Keychains/**" },
        { "path": "$HOME/Library/LaunchAgents/**" },
        { "path": "$HOME/.zshrc" },
        { "path": "$HOME/.zshenv" },
        { "path": "$HOME/.zprofile" },
        { "path": "$HOME/.bashrc" },
        { "path": "$HOME/.bash_profile" },
        { "path": "$HOME/.profile" }
      ]
    }
  ]
}
