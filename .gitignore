# ── Zależności ──
node_modules/

# ── Build frontendu (Vite) ──
dist/
dist-ssr/
*.local

# ── Rust / Tauri ──
# (dublowane też w app/src-tauri/.gitignore)
target/
app/src-tauri/gen/schemas/

# ── Zbudowane pliki i instalatory ──
*.exe
*.msi
*.msix
*.app
*.dmg
*.AppImage
*.deb
*.rpm

# ── Sekrety / zmienne środowiskowe ──
.env
.env.*
!.env.example
# klucz Anthropic dla lokalnego serwera proxy (wrangler dev)
.dev.vars

# ── Cloudflare Workers (cache wranglera) ──
.wrangler/

# ── Logi ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Pliki systemowe ──
.DS_Store
Thumbs.db
desktop.ini

# ── Edytory / IDE ──
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.sw?

# ── Claude Code ──
# Worktree'e sesji. Każdy z nich ma własny plik .git, więc `git add -A`
# w korzeniu wciąga katalog jako gitlink (tryb 160000) — fantomowy submoduł,
# którego żaden klon nie pobierze. Skille w .claude/skills/ zostają śledzone.
.claude/worktrees/
